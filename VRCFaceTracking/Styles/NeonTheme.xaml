<!--
    Neon518 theme - the green-on-black look ported from VRC Parameter Relay's
    default "neon" theme (vrc_parameter_relay/ui/theme.py) so both apps match.

    Palette (verbatim from that theme):
      background #0a0c0a · panel #0f120f · card #121712 · card alt #0e120e
      input #121a13 · chip #131a15 · edge #36a35c · accent #31f272
      text #e6efe8 · dim #94a698 · dimmer #7f8f81 · faint #5f6f63
      danger #ff5561 · switch off #a51830 · switch on #1cf26b

    These are defined at dictionary top level (not inside ThemeDictionaries) so
    they shadow WinUI's own theme brushes in both light and dark mode - this is
    a dark neon app now, regardless of the Windows theme.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Raw palette ===================== -->
    <Color x:Key="Neon518BackgroundColor">#0a0c0a</Color>
    <Color x:Key="Neon518PanelColor">#0f120f</Color>
    <Color x:Key="Neon518CardColor">#121712</Color>
    <Color x:Key="Neon518CardAltColor">#0e120e</Color>
    <Color x:Key="Neon518InputColor">#121a13</Color>
    <Color x:Key="Neon518ChipColor">#131a15</Color>
    <Color x:Key="Neon518EdgeColor">#36a35c</Color>
    <Color x:Key="Neon518AccentColor">#31f272</Color>
    <Color x:Key="Neon518AccentDimColor">#3fce74</Color>
    <Color x:Key="Neon518AccentHoverColor">#7dffab</Color>
    <Color x:Key="Neon518OnAccentColor">#04150b</Color>
    <Color x:Key="Neon518TextColor">#e6efe8</Color>
    <Color x:Key="Neon518TextStrongColor">#f2f8f3</Color>
    <Color x:Key="Neon518TextDimColor">#94a698</Color>
    <Color x:Key="Neon518TextDimmerColor">#7f8f81</Color>
    <Color x:Key="Neon518TextFaintColor">#5f6f63</Color>
    <Color x:Key="Neon518DangerColor">#ff5561</Color>
    <Color x:Key="Neon518DangerEdgeColor">#542a2a</Color>
    <Color x:Key="Neon518WarnColor">#ffb454</Color>
    <Color x:Key="Neon518SwitchOffColor">#a51830</Color>
    <Color x:Key="Neon518SwitchOnColor">#1cf26b</Color>
    <Color x:Key="Neon518HoverColor">#142418</Color>
    <Color x:Key="Neon518PressedColor">#0f150f</Color>
    <Color x:Key="Neon518SelectedColor">#1b5a30</Color>
    <Color x:Key="Neon518SliderTrackColor">#1d5a32</Color>
    <Color x:Key="Neon518SliderFillColor">#22d968</Color>

    <SolidColorBrush x:Key="Neon518BackgroundBrush" Color="{StaticResource Neon518BackgroundColor}" />
    <SolidColorBrush x:Key="Neon518PanelBrush" Color="{StaticResource Neon518PanelColor}" />
    <SolidColorBrush x:Key="Neon518CardBrush" Color="{StaticResource Neon518CardColor}" />
    <SolidColorBrush x:Key="Neon518EdgeBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="Neon518AccentBrush" Color="{StaticResource Neon518AccentColor}" />
    <SolidColorBrush x:Key="Neon518DangerBrush" Color="{StaticResource Neon518DangerColor}" />
    <SolidColorBrush x:Key="Neon518WarnBrush" Color="{StaticResource Neon518WarnColor}" />
    <SolidColorBrush x:Key="Neon518TextDimBrush" Color="{StaticResource Neon518TextDimColor}" />
    <SolidColorBrush x:Key="Neon518ChipBrush" Color="{StaticResource Neon518ChipColor}" />

    <!-- ===================== Category hues =====================
         The six vibrant category colours from VRC Parameter Relay's palette, used to
         colour-code sections. Each hue has a vibrant tone (text/icons), a mid tone
         (borders) and a dark tint (fills), exactly as CATEGORY_PALETTE defines them. -->
    <SolidColorBrush x:Key="Cat518Green" Color="#4af58c" />
    <SolidColorBrush x:Key="Cat518GreenEdge" Color="#2f5e3f" />
    <SolidColorBrush x:Key="Cat518GreenTint" Color="#10291a" />

    <SolidColorBrush x:Key="Cat518Blue" Color="#7aa7ff" />
    <SolidColorBrush x:Key="Cat518BlueEdge" Color="#3a5384" />
    <SolidColorBrush x:Key="Cat518BlueTint" Color="#131c30" />

    <SolidColorBrush x:Key="Cat518Cyan" Color="#56d9f2" />
    <SolidColorBrush x:Key="Cat518CyanEdge" Color="#2f6b7a" />
    <SolidColorBrush x:Key="Cat518CyanTint" Color="#0e2229" />

    <SolidColorBrush x:Key="Cat518Yellow" Color="#ffb454" />
    <SolidColorBrush x:Key="Cat518YellowEdge" Color="#6b5320" />
    <SolidColorBrush x:Key="Cat518YellowTint" Color="#291f0c" />

    <SolidColorBrush x:Key="Cat518Red" Color="#ff5561" />
    <SolidColorBrush x:Key="Cat518RedEdge" Color="#5c2228" />
    <SolidColorBrush x:Key="Cat518RedTint" Color="#2a1014" />

    <SolidColorBrush x:Key="Cat518Purple" Color="#d78cff" />
    <SolidColorBrush x:Key="Cat518PurpleEdge" Color="#5e3f78" />
    <SolidColorBrush x:Key="Cat518PurpleTint" Color="#221430" />

    <!-- Section card: a hue-tinted fill with a matching hairline, like the relay's
         category frames. Set BorderBrush/Background per section from the hues above. -->
    <Style x:Key="Cat518SectionBorderStyle" TargetType="Border">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- ===================== Shape ===================== -->
    <!-- Their look is noticeably rounder than stock WinUI (buttons 8px, cards 12px) -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

    <!-- ===================== Page & layer backgrounds ===================== -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource Neon518BackgroundColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource Neon518BackgroundColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource Neon518PanelColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource Neon518CardColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource Neon518CardColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{StaticResource Neon518BackgroundColor}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource Neon518CardColor}" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource Neon518CardAltColor}" />
    <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="{StaticResource Neon518CardColor}" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush" Color="{StaticResource Neon518CardColor}" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorSecondaryBrush" Color="{StaticResource Neon518PanelColor}" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorTertiaryBrush" Color="{StaticResource Neon518CardColor}" />

    <!-- ===================== Cards ===================== -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Neon518CardColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource Neon518CardAltColor}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="{StaticResource Neon518EdgeColor}" />

    <!-- ===================== Text ===================== -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Neon518TextColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Neon518TextDimColor}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Neon518TextDimmerColor}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource Neon518TextFaintColor}" />
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="{StaticResource Neon518OnAccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource Neon518AccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="{StaticResource Neon518AccentDimColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="{StaticResource Neon518AccentDimColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource Neon518OnAccentColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource Neon518OnAccentColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{StaticResource Neon518OnAccentColor}" />

    <!-- ===================== Accent ===================== -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource Neon518AccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource Neon518AccentDimColor}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource Neon518AccentDimColor}" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource Neon518AccentColor}" />
    <SolidColorBrush x:Key="AccentAAFillColorDefaultBrush" Color="{StaticResource Neon518AccentColor}" />
    <!-- These are Colors in WinUI, not Brushes - keep the types right or templates that
         feed them into gradients will fail at runtime. -->
    <Color x:Key="SystemAccentColor">#31f272</Color>
    <Color x:Key="SystemAccentColorLight1">#62ff97</Color>
    <Color x:Key="SystemAccentColorLight2">#7dffab</Color>
    <Color x:Key="SystemAccentColorLight3">#a8ffc7</Color>
    <Color x:Key="SystemAccentColorDark1">#22d968</Color>
    <Color x:Key="SystemAccentColorDark2">#1cb356</Color>
    <Color x:Key="SystemAccentColorDark3">#158c42</Color>

    <!-- ===================== Controls (fills & strokes) ===================== -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource Neon518InputColor}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource Neon518HoverColor}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource Neon518PressedColor}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{StaticResource Neon518CardAltColor}" />
    <SolidColorBrush x:Key="ControlFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource Neon518InputColor}" />
    <SolidColorBrush x:Key="ControlSolidFillColorDefaultBrush" Color="{StaticResource Neon518InputColor}" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="{StaticResource Neon518InputColor}" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="{StaticResource Neon518HoverColor}" />
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="{StaticResource Neon518PressedColor}" />
    <SolidColorBrush x:Key="ControlAltFillColorDisabledBrush" Color="Transparent" />

    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="{StaticResource Neon518AccentColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentSecondaryBrush" Color="{StaticResource Neon518AccentDimColor}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="{StaticResource Neon518DangerEdgeColor}" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="{StaticResource Neon518AccentDimColor}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorFlyoutBrush" Color="{StaticResource Neon518EdgeColor}" />

    <!-- Subtle (transparent-ish) interaction layers used by buttons, list items, nav items -->
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{StaticResource Neon518HoverColor}" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource Neon518PressedColor}" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="Transparent" />

    <!-- ===================== Buttons ===================== -->
    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource Neon518HoverColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource Neon518PressedColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource Neon518AccentDimColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{StaticResource Neon518DangerEdgeColor}" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource Neon518TextColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource Neon518TextStrongColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource Neon518TextDimColor}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource Neon518TextFaintColor}" />

    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource Neon518AccentColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{StaticResource Neon518AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{StaticResource Neon518AccentDimColor}" />
    <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{StaticResource Neon518AccentColor}" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource Neon518OnAccentColor}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource Neon518OnAccentColor}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource Neon518OnAccentColor}" />

    <!-- ===================== Text input ===================== -->
    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource Neon518InputColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource Neon518InputColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource Neon518InputColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource Neon518AccentDimColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource Neon518AccentColor}" />
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource Neon518TextColor}" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="{StaticResource Neon518TextStrongColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource Neon518TextFaintColor}" />
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource Neon518AccentColor}" />

    <!-- ===================== ToggleSwitch (their red/green pill) ===================== -->
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{StaticResource Neon518SwitchOffColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#c01d38" />
    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#8d1429" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource Neon518DangerEdgeColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{StaticResource Neon518DangerColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#ffd9de" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#ffffff" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource Neon518SwitchOnColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource Neon518AccentHoverColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource Neon518AccentDimColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{StaticResource Neon518SwitchOnColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="{StaticResource Neon518OnAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="{StaticResource Neon518OnAccentColor}" />

    <!-- ===================== Slider ===================== -->
    <SolidColorBrush x:Key="SliderTrackFill" Color="{StaticResource Neon518SliderTrackColor}" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="{StaticResource Neon518SliderTrackColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource Neon518SliderFillColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource Neon518AccentColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource Neon518AccentColor}" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource Neon518AccentColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource Neon518AccentHoverColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource Neon518AccentHoverColor}" />

    <!-- ===================== CheckBox ===================== -->
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource Neon518AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource Neon518AccentHoverColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{StaticResource Neon518AccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{StaticResource Neon518OnAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="{StaticResource Neon518EdgeColor}" />

    <!-- ===================== Navigation ===================== -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="{StaticResource Neon518PanelColor}" />
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{StaticResource Neon518PanelColor}" />
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource Neon518BackgroundColor}" />
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{StaticResource Neon518SelectedColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#22703c" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{StaticResource Neon518TextStrongColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{StaticResource Neon518TextDimColor}" />
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{StaticResource Neon518TextStrongColor}" />
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{StaticResource Neon518HoverColor}" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource Neon518AccentColor}" />

    <!-- ===================== Lists ===================== -->
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="{StaticResource Neon518HoverColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="{StaticResource Neon518PressedColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="{StaticResource Neon518SelectedColor}" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#22703c" />
    <SolidColorBrush x:Key="ListViewItemForeground" Color="{StaticResource Neon518TextColor}" />
    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{StaticResource Neon518TextStrongColor}" />

    <!-- ===================== Expander (Tracking Mutations page) ===================== -->
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="{StaticResource Neon518CardColor}" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="ExpanderContentBackground" Color="{StaticResource Neon518CardAltColor}" />
    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="ExpanderChevronForeground" Color="{StaticResource Neon518AccentDimColor}" />

    <!-- ===================== Flyouts, dialogs, tooltips ===================== -->
    <SolidColorBrush x:Key="FlyoutBackground" Color="{StaticResource Neon518CardColor}" />
    <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource Neon518CardColor}" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="{StaticResource Neon518CardColor}" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="{StaticResource Neon518TextColor}" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource Neon518InputColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource Neon518EdgeColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource Neon518CardColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource Neon518EdgeColor}" />

    <!-- ===================== Scrollbars ===================== -->
    <SolidColorBrush x:Key="ScrollBarBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ScrollBarForeground" Color="#245c38" />
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#245c38" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{StaticResource Neon518AccentColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="{StaticResource Neon518AccentColor}" />

    <!-- ===================== InfoBar ===================== -->
    <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#291f0c" />
    <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#2a1014" />
    <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#10291a" />
    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="{StaticResource Neon518CardColor}" />
    <SolidColorBrush x:Key="InfoBarBorderBrush" Color="{StaticResource Neon518EdgeColor}" />

    <!-- ===================== Named styles for our own pages ===================== -->

    <!-- Rounded outlined "chip", like their status pills -->
    <Style x:Key="Neon518ChipBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Neon518ChipBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Neon518EdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,3,12,3" />
    </Style>

    <!-- Card frame: their 12px radius hairline card -->
    <Style x:Key="Neon518CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Neon518CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Neon518EdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Small monospace readout, like their status bar / value labels -->
    <Style x:Key="Neon518ReadoutTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Neon518TextDimBrush}" />
    </Style>

</ResourceDictionary>
