<Page
    x:Class="VRCFaceTracking.Views.CompatibilityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:VRCFaceTracking.Helpers">

    <Page.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Margin="0,0,0,20" MaxWidth="900" HorizontalAlignment="Left">

            <!-- What this is : green -->
            <Border Style="{StaticResource Cat518SectionBorderStyle}"
                    Background="{StaticResource Cat518GreenTint}"
                    BorderBrush="{StaticResource Cat518GreenEdge}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Avatar compatibility"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Cat518Green}"/>
                    <TextBlock Text="Run any tracking hardware, keep avatars tuned for any ecosystem. Pick the dialect your avatar was built for - the running hardware is detected automatically and only the missing behaviors are synthesized. Real signals always win over synthesized ones."
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.SourceLine, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Profile picker : cyan -->
            <Border Style="{StaticResource Cat518SectionBorderStyle}"
                    Background="{StaticResource Cat518CyanTint}"
                    BorderBrush="{StaticResource Cat518CyanEdge}">
                <StackPanel Spacing="6">
                    <TextBlock Text="My avatar was tuned for..."
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Cat518Cyan}"/>
                    <RadioButtons SelectedIndex="{x:Bind ViewModel.ProfileIndex, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.MutationFound, Mode=OneWay}">
                        <RadioButton Content="Nothing special - raw passthrough (native Dream Air / Babble dialect)"/>
                        <RadioButton Content="Quest Pro face tracking (Virtual Desktop / Link)"/>
                        <RadioButton Content="Vive Pro Eye + Facial Tracker (SRanipal)"/>
                    </RadioButtons>
                    <TextBlock Text="{x:Bind ViewModel.StatusLine, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Fine tuning : purple, only while a translation is active -->
            <Border Style="{StaticResource Cat518SectionBorderStyle}"
                    Background="{StaticResource Cat518PurpleTint}"
                    BorderBrush="{StaticResource Cat518PurpleEdge}"
                    Visibility="{x:Bind ViewModel.KnobsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Fine tuning"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Cat518Purple}"/>

                    <Slider Header="Cheek squint / dimple from smile strength"
                            Minimum="0" Maximum="1" StepFrequency="0.05"
                            Value="{x:Bind ViewModel.CheekFromSmile, Mode=TwoWay}"/>

                    <StackPanel Spacing="8"
                                Visibility="{x:Bind ViewModel.IsQuestPro, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Slider Header="Squint begins below this eyelid openness"
                                Minimum="0" Maximum="1" StepFrequency="0.05"
                                Value="{x:Bind ViewModel.SquintStart, Mode=TwoWay}"/>
                        <Slider Header="Fully squinted at this openness"
                                Minimum="0" Maximum="1" StepFrequency="0.05"
                                Value="{x:Bind ViewModel.SquintFull, Mode=TwoWay}"/>
                        <Slider Header="Squint closes the lids (Quest Pro openness coupling)"
                                Minimum="0" Maximum="1" StepFrequency="0.05"
                                Value="{x:Bind ViewModel.OpennessCoupling, Mode=TwoWay}"/>
                        <ToggleSwitch Header="Constant pupil, exactly like the real Quest Pro"
                                      OnContent="Frozen at 0.5 (authentic)" OffContent="Real Tobii pupil"
                                      IsOn="{x:Bind ViewModel.QpConstantPupil, Mode=TwoWay}"/>
                        <ToggleSwitch Header="Synthesize eye widen from very open lids"
                                      OnContent="On" OffContent="Off"
                                      IsOn="{x:Bind ViewModel.WideFromLid, Mode=TwoWay}"/>
                        <Slider Header="Widen begins above this openness"
                                Minimum="0.5" Maximum="1" StepFrequency="0.01"
                                Value="{x:Bind ViewModel.WideStart, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.WideFromLid, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <TextBlock Text="Settings apply live and persist automatically. Verify on Tracking Debug (shape values) and VRChat Output (what actually leaves for VRChat)."
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
