<Page
    x:Class="VRCFaceTracking.Views.TrackingDebugPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VRCFaceTracking.ViewModels"
    xmlns:helpers="using:VRCFaceTracking.Helpers">

    <Page.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <DataTemplate x:Key="DebugRowTemplate" x:DataType="vm:DebugRow">
            <Grid Padding="0,2,0,2" Visibility="{x:Bind Visible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="1*" MinWidth="90"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="1.4*" MinWidth="130"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>

                <Ellipse Width="7" Height="7"
                         Fill="{StaticResource Cat518Amber}"
                         VerticalAlignment="Center"
                         Visibility="{x:Bind RecentlyChanged, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

                <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                           FontSize="12" VerticalAlignment="Center"/>

                <ProgressBar Grid.Column="2"
                             Minimum="0" Maximum="1"
                             Value="{x:Bind BarNorm, Mode=OneWay}"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>

                <TextBlock Grid.Column="3" Text="{x:Bind RawText, Mode=OneWay}"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{x:Bind MutatedText, Mode=OneWay}"
                           FontFamily="Consolas" FontSize="11"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="5" Text="{x:Bind Source, Mode=OneWay}"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBlock Grid.Column="6" Text="{x:Bind UpdatedAgo, Mode=OneWay}"
                           FontFamily="Consolas" FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Margin="0,0,0,20">

            <!-- Routing header : green section -->
            <Border Style="{StaticResource Cat518SectionBorderStyle}"
                    Background="{StaticResource Cat518GreenTint}"
                    BorderBrush="{StaticResource Cat518GreenEdge}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Where the data comes from"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Cat518Green}"/>
                    <TextBlock Text="{x:Bind ViewModel.SlotSummary, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="12"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.RoutingSummary, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                        <TextBox PlaceholderText="filter shapes..."
                                 MinWidth="220"
                                 Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Content="Only moving (last 2 s)"
                                  IsChecked="{x:Bind ViewModel.OnlyMoving, Mode=TwoWay}"/>
                    </StackPanel>
                    <TextBlock Text="raw = what the module wrote  |  mut = after Tracking Mutations / curves  |  amber dot = changed in the last 0.4 s"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Eye signals : cyan section -->
            <Border Style="{StaticResource Cat518SectionBorderStyle}"
                    Background="{StaticResource Cat518CyanTint}"
                    BorderBrush="{StaticResource Cat518CyanEdge}">
                <StackPanel>
                    <TextBlock Text="Eye signals"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Cat518Cyan}"
                               Margin="0,0,0,6"/>
                    <Grid Padding="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="1*" MinWidth="90"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="1.4*" MinWidth="130"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="signal" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="raw" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Grid.Column="4" Text="mut" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Grid.Column="5" Text="source" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Grid.Column="6" Text="changed" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.EyeRows}"
                                  ItemTemplate="{StaticResource DebugRowTemplate}"/>
                </StackPanel>
            </Border>

            <!-- Unified expression shapes : purple section -->
            <Border Style="{StaticResource Cat518SectionBorderStyle}"
                    Background="{StaticResource Cat518PurpleTint}"
                    BorderBrush="{StaticResource Cat518PurpleEdge}">
                <StackPanel>
                    <TextBlock Text="Unified expression shapes"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Cat518Purple}"
                               Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ShapeRows}"
                                  ItemTemplate="{StaticResource DebugRowTemplate}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
