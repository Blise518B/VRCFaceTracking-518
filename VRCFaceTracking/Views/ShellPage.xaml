<Page
    x:Class="VRCFaceTracking.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:VRCFaceTracking.Helpers"
    xmlns:behaviors="using:VRCFaceTracking.Behaviors"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    Loaded="OnLoaded">

    <Grid>
        <Grid x:Name="AppTitleBar"
              Canvas.ZIndex="1"
              Height="{Binding ElementName=NavigationViewControl, Path=CompactPaneLength}"
              IsHitTestVisible="True"
              VerticalAlignment="Top">
            <Image Source="/Assets/WindowIcon.ico"
                   HorizontalAlignment="Left"
                   Width="16"
                   Height="16" />
            <TextBlock x:Name="AppTitleBarText"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Margin="28,0,0,0"/>
        </Grid>
        <NavigationView
            x:Name="NavigationViewControl"
            Canvas.ZIndex="0"
            IsBackButtonVisible="Visible"
            IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
            IsSettingsVisible="True"
            ExpandedModeThresholdWidth="1280"
            DisplayModeChanged="NavigationViewControl_DisplayModeChanged"
            ItemInvoked="NavigationViewControl_ItemInvoked"
            Header="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}">
            <NavigationView.MenuItems>
                <!--
                TODO: Update item titles by updating <x:Uid>.Content entries in Strings/en-us/Resources.resw.
                https://docs.microsoft.com/windows/uwp/app-resources/localize-strings-ui-manifest#refer-to-a-string-resource-identifier-from-xaml
            
                TODO: Update item icons by updating FontIcon.Glyph properties.
                https://docs.microsoft.com/windows/apps/design/style/segoe-fluent-icons-font#icon-list
                -->
                <NavigationViewItem x:Uid="Shell_Main" helpers:NavigationHelper.NavigateTo="VRCFaceTracking.ViewModels.MainViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--<NavigationViewItem x:Uid="Shell_Parameters" helpers:NavigationHelper.NavigateTo="VRCFaceTracking.ViewModels.ParametersViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9E9;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>-->
                <NavigationViewItem Content="Launch Apps"
                                    ToolTipService.ToolTip="Start BrokenEye, EyeTrackVR, Babble and friends without leaving VRCFaceTracking"
                                    helpers:NavigationHelper.NavigateTo="VRCFaceTracking.ViewModels.UtilitiesViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7B5;" Foreground="{StaticResource Cat518Green}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_Output" helpers:NavigationHelper.NavigateTo="VRCFaceTracking.ViewModels.OutputViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA37;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_ModuleRegistry" helpers:NavigationHelper.NavigateTo="VRCFaceTracking.ViewModels.ModuleRegistryViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE896;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_TrackingSettings" helpers:NavigationHelper.NavigateTo="VRCFaceTracking.ViewModels.MutatorViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE70F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_Curves" helpers:NavigationHelper.NavigateTo="VRCFaceTracking.ViewModels.CurvesViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE9D2;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_Sources" helpers:NavigationHelper.NavigateTo="VRCFaceTracking.ViewModels.SourcesViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE957;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tracking Debug"
                                    ToolTipService.ToolTip="Live view of every unified expression shape: value, source, and update activity"
                                    helpers:NavigationHelper.NavigateTo="VRCFaceTracking.ViewModels.TrackingDebugViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEBE8;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="VRChat Output"
                                    ToolTipService.ToolTip="Ground truth: every OSC message actually sent to VRChat, recorded at the wire"
                                    helpers:NavigationHelper.NavigateTo="VRCFaceTracking.ViewModels.VrcOutputViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE774;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Compatibility"
                                    ToolTipService.ToolTip="Run any hardware, keep avatars tuned for Quest Pro or Vive - dialect translation"
                                    helpers:NavigationHelper.NavigateTo="VRCFaceTracking.ViewModels.CompatibilityViewModel">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8AB;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <!-- An action, not a page: switches this session to the console monitor.
                 Lives in the pane because it's needed often, especially during setup. -->
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="LiteConsoleNavItem"
                                    Content="Lite Console"
                                    ToolTipService.ToolTip="Switch this session to the lightweight console monitor right now. Press F (or click FULL APP) in the console to come back.">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7F4;" Foreground="{StaticResource Cat518Cyan}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.HeaderTemplate>
                <DataTemplate>
                    <Grid>
                        <TextBlock
                            Text="{Binding}"
                            Style="{ThemeResource TitleTextBlockStyle}" />
                    </Grid>
                </DataTemplate>
            </NavigationView.HeaderTemplate>
            <i:Interaction.Behaviors>
                <behaviors:NavigationViewHeaderBehavior
                    DefaultHeader="{x:Bind ((ContentControl)ViewModel.Selected).Content, Mode=OneWay}">
                    <behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock
                                    Text="{Binding}"
                                    Style="{ThemeResource TitleTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </behaviors:NavigationViewHeaderBehavior.DefaultHeaderTemplate>
                </behaviors:NavigationViewHeaderBehavior>
            </i:Interaction.Behaviors>
            <Grid Margin="{StaticResource NavigationViewPageContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Update banner (518 fork): shows above every page, so a new release is
                     seen without visiting Settings. Collapses to nothing when closed. -->
                <InfoBar Grid.Row="0"
                         Margin="0,0,0,12"
                         IsOpen="{x:Bind Updates.ShowBanner, Mode=OneWay}"
                         Severity="{x:Bind SeverityFor(Updates.BannerKind), Mode=OneWay}"
                         Title="{x:Bind Updates.BannerTitle, Mode=OneWay}"
                         Message="{x:Bind Updates.BannerMessage, Mode=OneWay}"
                         IsClosable="True"
                         CloseButtonClick="UpdateBanner_CloseButtonClick">
                    <InfoBar.Content>
                        <StackPanel Margin="0,0,0,12" Spacing="8">
                            <ProgressBar Value="{x:Bind Updates.DownloadProgress, Mode=OneWay}"
                                         Maximum="100"
                                         Visibility="{x:Bind Updates.ShowProgress, Mode=OneWay}"/>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind Updates.ShowBannerButtons, Mode=OneWay}">
                                <Button Style="{StaticResource AccentButtonStyle}"
                                        Content="{x:Bind Updates.InstallButtonText, Mode=OneWay}"
                                        IsEnabled="{x:Bind Updates.CanInstall, Mode=OneWay}"
                                        Click="UpdateNow_Click"/>
                                <Button Content="What's new" Click="WhatsNew_Click"/>
                                <Button Content="Skip this version" Click="SkipVersion_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
                <Frame Grid.Row="1" x:Name="NavigationFrame" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
