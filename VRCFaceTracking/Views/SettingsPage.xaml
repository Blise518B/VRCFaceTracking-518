<Page
    x:Class="VRCFaceTracking.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:labs="using:CommunityToolkit.Labs.WinUI"
    xmlns:models="using:VRCFaceTracking.Models"
    mc:Ignorable="d">
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">3</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,29,0,5" />
            </Style.Setters>
        </Style>
    </Page.Resources>
    <Grid>
        <ScrollViewer
            Padding="0,0,0,0"
            IsTabStop="False"
            UseSystemFocusVisuals="False"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>
                
                <labs:SettingsCard x:Uid="ThemeSettings">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" Foreground="{StaticResource Cat518Cyan}" />
                    </labs:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="themeMode" SelectionChanged="themeMode_SelectionChanged">
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                        <ComboBoxItem Content="Use system setting" Tag="Default" />
                    </ComboBox>
                </labs:SettingsCard>

                <labs:SettingsCard x:Uid="OscSettings">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEC05;" Foreground="{StaticResource Cat518Blue}" />
                    </labs:SettingsCard.HeaderIcon>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <NumberBox
                                Header="Legacy Receive Port"
                                SpinButtonPlacementMode="Inline"
                                SmallChange="1"
                                LargeChange="10"
                                Margin="15, 0, 15, 0"
                                Minimum="1"
                                Maximum="65535"
                                Value="{x:Bind OscTarget.InPort, Mode=TwoWay}"/>
                            
                            <TextBox
                                     Header="IP Address" 
                                     PlaceholderText="127.0.0.1" 
                                     Text="{x:Bind OscTarget.DestinationAddress, Mode=TwoWay}"/>
                            
                            <NumberBox
                                Header="Send Port"
                                SpinButtonPlacementMode="Inline"
                                SmallChange="1"
                                LargeChange="10" 
                                Minimum="1"
                                Maximum="65535"
                                Margin="15, 0, 15, 0"
                                Value="{x:Bind OscTarget.OutPort, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                </labs:SettingsCard>
                
                <labs:SettingsCard x:Uid="AutoStartSettings" IsEnabled="{x:Bind ViewModel.IsOpenVREnabled, Mode=OneWay}">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE840;" Foreground="{StaticResource Cat518Green}" />
                    </labs:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}"/>
                </labs:SettingsCard>

                <labs:SettingsCard Header="Use OSC Router 518"
                                   Description="Also receive VRChat data through the local OSC router - keeps tracking feedback working when VRChat's discovery dies after long sessions. Harmless when the router isn't running (518 fork feature)">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;" Foreground="{StaticResource Cat518Green}" />
                    </labs:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.RouterClient.Enabled, Mode=TwoWay}"/>
                </labs:SettingsCard>

                <labs:SettingsCard Header="SteamVR auto-launch starts"
                                   Description="The lite monitor is one small screen and uses far less memory. Both share the same settings, so curves tuned here apply either way (518 fork feature)">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F4;" Foreground="{StaticResource Cat518Cyan}" />
                    </labs:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="LaunchModeCombo"
                              MinWidth="190"
                              SelectionChanged="LaunchModeCombo_SelectionChanged">
                        <ComboBoxItem Content="The full app"/>
                        <ComboBoxItem Content="The lite monitor"/>
                    </ComboBox>
                </labs:SettingsCard>
                
                <labs:SettingsExpander Header="Crash Auto-Restart"
                                       Description="Automatically restart crashed tracking modules and relaunch VRCFaceTracking if it crashes (518 fork feature)">
                    <labs:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE72C;" Foreground="{StaticResource Cat518Yellow}" />
                    </labs:SettingsExpander.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.AutoRestart.Enabled, Mode=TwoWay}"/>
                    <labs:SettingsExpander.Items>
                        <labs:SettingsCard Header="Module restarts"
                                           Description="How many times a crashed tracking module was automatically restarted">
                            <TextBlock Text="{x:Bind ViewModel.AutoRestart.ModuleRestartCount, Mode=OneWay}" FontFamily="Consolas" Foreground="{StaticResource Cat518Cyan}"/>
                        </labs:SettingsCard>
                        <labs:SettingsCard Header="App relaunches"
                                           Description="How many times VRCFaceTracking was automatically relaunched after a crash">
                            <TextBlock Text="{x:Bind ViewModel.AutoRestart.AppRelaunchCount, Mode=OneWay}" FontFamily="Consolas" Foreground="{StaticResource Cat518Purple}"/>
                        </labs:SettingsCard>
                        <labs:SettingsCard Header="Recent restarts"
                                           HorizontalContentAlignment="Stretch"
                                           ContentAlignment="Vertical">
                            <StackPanel>
                                <TextBlock Text="No restarts recorded - everything has been stable."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind HasNoRestartEvents, Mode=OneWay}"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.AutoRestart.RecentEvents, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}"
                                                       FontFamily="Consolas"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,1,0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </labs:SettingsCard>
                        <labs:SettingsCard Header="Reset statistics"
                                           Description="Clears both counters and the restart log">
                            <Button Content="Reset" Click="ResetRestartStats_OnClick"/>
                        </labs:SettingsCard>
                    </labs:SettingsExpander.Items>
                </labs:SettingsExpander>

                <labs:SettingsExpander Header="Crash reports"
                                       Description="Every crash is written to a readable report so the cause can be tracked down (518 fork feature)">
                    <labs:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" Foreground="{StaticResource Cat518Red}" />
                    </labs:SettingsExpander.HeaderIcon>
                    <Button Content="Open reports folder" Click="OpenCrashFolder_OnClick"/>
                    <labs:SettingsExpander.Items>
                        <labs:SettingsCard Header="Most recent crash"
                                           HorizontalContentAlignment="Left"
                                           ContentAlignment="Vertical">
                            <TextBlock Text="{x:Bind LastCrashText, Mode=OneWay}" FontFamily="Consolas" Foreground="{StaticResource Cat518Yellow}"
                                       TextWrapping="Wrap"/>
                        </labs:SettingsCard>
                        <labs:SettingsCard Header="Saved reports"
                                           Description="Newest first, up to the last 20. Send one of these along if you want a crash looked at."
                                           HorizontalContentAlignment="Stretch"
                                           ContentAlignment="Vertical">
                            <StackPanel>
                                <TextBlock Text="No crash reports - nothing has crashed since this was added."
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind NoCrashReportsVisibility, Mode=OneWay}"
                                           TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.CrashReportNames, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,1,0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </labs:SettingsCard>
                    </labs:SettingsExpander.Items>
                </labs:SettingsExpander>

                <labs:SettingsExpander x:Uid="RiskySettings">
                    <labs:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7BA;" Foreground="{StaticResource Cat518Purple}" />
                    </labs:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="dangerAcceptToggle" Toggled="AcceptToggle_OnToggled" OnContent="Gremlin Mode" IsOn="{x:Bind RiskySettingsViewModel.Enabled, Mode=OneWay}"/>
                    <labs:SettingsExpander.Items>
                        <labs:SettingsCard x:Uid="ForceRelevancyToggle"
                            x:Name="allParamsRelevant"
                            IsEnabled="False">
                            <ToggleSwitch x:Name="allParamsRelevantToggle" IsOn="{x:Bind RiskySettingsViewModel.AllRelevantDebug, Mode=TwoWay}" />
                        </labs:SettingsCard>
                        <labs:SettingsCard x:Uid="ForceReInitButton"
                            x:Name="forceReInit"
                            IsEnabled="False">
                            <Button x:Name="forceReInitButton" Click="forceReInitButton_OnClick" x:Uid="ReInitButton" />
                        </labs:SettingsCard>
                        <labs:SettingsCard x:Uid="ResetVRCFTButton"
                            x:Name="resetVRCFT"
                            IsEnabled="False">
                            <Button x:Name="resetVRCFTButton" Click="resetVRCFTButton_OnClick" x:Uid="ResetButton" />
                        </labs:SettingsCard>
                        <labs:SettingsCard x:Uid="ResetAvatarConfButton"
                            x:Name="resetAvatarConfig"
                            IsEnabled="False">
                            <Button x:Name="resetVRCAvatarConf" Click="resetVRCAvatarConf_OnClick" x:Uid="ResetButton" />
                        </labs:SettingsCard>
                    </labs:SettingsExpander.Items>
                </labs:SettingsExpander>

                <!-- Debug Hardware -->
                <labs:SettingsCard x:Uid="HardwareDebug" ContentAlignment="Vertical">
                    <labs:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEBE8;" Foreground="{StaticResource Cat518Cyan}" />
                    </labs:SettingsCard.HeaderIcon>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /> <!-- Separator Column -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{x:Bind UpperImageSource}" Stretch="Uniform" />
                        <AppBarSeparator x:Name="HardwareDebugSeparator" Grid.Column="1" />
                        <Image Grid.Column="2" Source="{x:Bind LowerImageSource}" Stretch="Uniform" />
                    </Grid>
                </labs:SettingsCard>

                <!--  About  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" x:Uid="About" />
                
                <labs:SettingsExpander x:Uid="Copyright" Header="VRCFaceTracking">
                    <TextBlock
                            Margin="0,-2,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Version}" />
                    <labs:SettingsExpander.Items>
                        <labs:SettingsCard
                            x:Uid="PrivacyPolicyCard"
                            IsClickEnabled="True"
                            Click="privacyPolicyCard_Click">
                            <labs:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </labs:SettingsCard.ActionIcon>
                        </labs:SettingsCard>
                        <labs:SettingsCard x:Uid="CloneRepoCard">
                            <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="git clone https://github.com/benaclejames/VRCFaceTracking" />
                        </labs:SettingsCard>
                        <labs:SettingsCard
                                x:Uid="BugRequestCard"
                                IsClickEnabled="True"
                                Click="bugRequestCard_Click">
                            <labs:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </labs:SettingsCard.ActionIcon>
                        </labs:SettingsCard>
                        <labs:SettingsCard
                                HorizontalContentAlignment="Left"
                                ContentAlignment="Vertical"
                                x:Uid="Dependencies">
                            <StackPanel Margin="-12,0,0,0" Orientation="Vertical">
                                <HyperlinkButton Content="SimpleRustOSC" NavigateUri="https://github.com/benaclejames/SimpleRustOSC" />
                            </StackPanel>
                        </labs:SettingsCard>
                        <labs:SettingsCard
                                HorizontalContentAlignment="Left"
                                ContentAlignment="Vertical"
                                x:Uid="Disclaimer">
                        </labs:SettingsCard>
                    </labs:SettingsExpander.Items>
                </labs:SettingsExpander>
                
                <labs:SettingsExpander x:Uid="Credits" Header="Credits">
                    <labs:SettingsExpander.Items>
                        <labs:SettingsCard HorizontalContentAlignment="Stretch"
                                           ContentAlignment="Vertical"
                                           x:Uid="ContributorsCard">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Contributors, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:GithubContributor">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Left alligned hyperlink w/ text -->
                                                <HyperlinkButton Grid.Column="0" Margin="-12,0,0,0" Content="{x:Bind login}" NavigateUri="{x:Bind html_url}"/>
                                                
                                                <!-- Right alligned text -->
                                                <TextBlock Grid.Column="1" Text="{x:Bind contributions}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="2" Text=" Contributions" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </labs:SettingsCard>
                    </labs:SettingsExpander.Items>
                </labs:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
