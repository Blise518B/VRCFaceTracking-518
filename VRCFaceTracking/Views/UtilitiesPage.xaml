<Page
    x:Class="VRCFaceTracking.Views.UtilitiesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VRCFaceTracking.ViewModels"
    xmlns:helpers="using:VRCFaceTracking.Helpers">

    <Page.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Margin="0,0,0,20">

            <!-- Header : green section -->
            <Border Style="{StaticResource Cat518SectionBorderStyle}"
                    Background="{StaticResource Cat518GreenTint}"
                    BorderBrush="{StaticResource Cat518GreenEdge}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Helper programs"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Cat518Green}"/>
                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"/>
                        <TextBlock Text="Start the programs your tracking needs without hunting for their windows. Green means it is already running."
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Launch all missing"
                            Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Center"
                            Click="LaunchAll_OnClick"/>
                </Grid>
            </Border>

            <!-- One card per helper program -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Apps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UtilityRow">
                        <Border Style="{StaticResource Cat518SectionBorderStyle}"
                                Background="{StaticResource Cat518CyanTint}"
                                BorderBrush="{StaticResource Cat518CyanEdge}"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- status pill -->
                                <Border CornerRadius="9" Padding="8,2,8,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Background="{StaticResource Cat518GreenTint}"
                                        BorderBrush="{StaticResource Cat518Green}"
                                        BorderThickness="1"
                                        Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="RUNNING" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource Cat518Green}"/>
                                </Border>
                                <Border CornerRadius="9" Padding="8,2,8,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        BorderBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                        BorderThickness="1"
                                        Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                                    <TextBlock Text="STOPPED" FontSize="10" FontWeight="Bold"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind LaunchCommand, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            Spacing="6" VerticalAlignment="Center">
                                    <ToggleSwitch OnContent="Auto" OffContent="Manual"
                                                  MinWidth="0" VerticalAlignment="Center"
                                                  IsOn="{x:Bind AutoLaunch, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="Start this program automatically when VRCFaceTracking starts"/>
                                    <!-- Nothing configured yet: offer the file picker straight away
                                         rather than a dead Launch button next to a gear icon nobody
                                         thinks to open. Swaps back to Launch once a path is set. -->
                                    <Button Content="Set path..."
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="{x:Bind Browse}"
                                            ToolTipService.ToolTip="Pick the program to start for this source"
                                            Visibility="{x:Bind NeedsSetup, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                    <Button Content="Launch"
                                            Style="{StaticResource AccentButtonStyle}"
                                            IsEnabled="{x:Bind CanLaunch, Mode=OneWay}"
                                            Click="{x:Bind Launch}"
                                            Visibility="{x:Bind NeedsSetup, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"/>
                                    <Button Padding="6,4,6,4"
                                            ToolTipService.ToolTip="Set how this program is started">
                                        <FontIcon Glyph="&#xE713;" FontSize="14"/>
                                        <Button.Flyout>
                                            <Flyout Placement="Left">
                                                <StackPanel Width="400" Spacing="8">
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="How to start"/>
                                                        <Run Text="{x:Bind Name}"/>
                                                    </TextBlock>
                                                    <TextBox Text="{x:Bind LaunchCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             PlaceholderText="C:\path\to\app.exe  -or-  steam://rungameid/..."
                                                             FontFamily="Consolas" FontSize="12"/>
                                                    <TextBlock Text="Quotes around paths with spaces are optional; anything after the path is passed as arguments."
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button Content="Save"
                                                                Style="{StaticResource AccentButtonStyle}"
                                                                Click="{x:Bind SaveCommand}"/>
                                                        <Button Content="Browse..." Click="{x:Bind Browse}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Notes}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
