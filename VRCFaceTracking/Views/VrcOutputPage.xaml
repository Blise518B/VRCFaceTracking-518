<Page
    x:Class="VRCFaceTracking.Views.VrcOutputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VRCFaceTracking.ViewModels"
    xmlns:helpers="using:VRCFaceTracking.Helpers">

    <Page.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Margin="0,0,0,20">

            <!-- Header : yellow section, this is the wire truth -->
            <Border Style="{StaticResource Cat518SectionBorderStyle}"
                    Background="{StaticResource Cat518YellowTint}"
                    BorderBrush="{StaticResource Cat518YellowEdge}">
                <StackPanel Spacing="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="What VRChat actually receives"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Cat518Yellow}"/>
                        <Button Grid.Column="1" Content="Clear seen"
                                Click="Clear_OnClick"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.HeaderLine, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.AvatarLine, Mode=OneWay}"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Every row was recorded at the moment it went onto the wire - nothing upstream, no buffers. If a shape looks right on Tracking Debug but its address is missing here, your avatar's config does not request that parameter (or it leaves re-encoded, e.g. as binary bits or a combined eyelid)."
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <TextBox PlaceholderText="filter addresses... (try: squint)"
                                 MinWidth="240"
                                 Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Content="Only moving (last 2 s)"
                                  IsChecked="{x:Bind ViewModel.OnlyMoving, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Sent addresses : purple section -->
            <Border Style="{StaticResource Cat518SectionBorderStyle}"
                    Background="{StaticResource Cat518PurpleTint}"
                    BorderBrush="{StaticResource Cat518PurpleEdge}">
                <StackPanel>
                    <Grid Padding="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="2.2*" MinWidth="220"/>
                            <ColumnDefinition Width="1*" MinWidth="80"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="76"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="address" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Grid.Column="3" Text="value" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Grid.Column="4" Text="type" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Grid.Column="5" Text="msg/s" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Grid.Column="6" Text="sent" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OutputRow">
                                <Grid Padding="0,2,0,2" Visibility="{x:Bind Visible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="2.2*" MinWidth="220"/>
                                        <ColumnDefinition Width="1*" MinWidth="80"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="76"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Width="7" Height="7"
                                             Fill="{StaticResource Cat518Yellow}"
                                             VerticalAlignment="Center"
                                             Visibility="{x:Bind RecentlySent, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

                                    <TextBlock Grid.Column="1" Text="{x:Bind Address}"
                                               FontFamily="Consolas" FontSize="11"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>

                                    <ProgressBar Grid.Column="2"
                                                 Minimum="0" Maximum="1"
                                                 Value="{x:Bind BarNorm, Mode=OneWay}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Visibility="{x:Bind IsFloat, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>

                                    <TextBlock Grid.Column="3" Text="{x:Bind ValueText, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind TypeName, Mode=OneWay}"
                                               FontSize="10"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{x:Bind Rate, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{x:Bind SentAgo, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="10"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Nothing sent yet - is VRChat running and the OSC socket connected?"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="{x:Bind NoRowsVisibility, Mode=OneWay}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
