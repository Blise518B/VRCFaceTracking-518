<Page
    x:Class="VRCFaceTracking.Views.OutputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:VRCFaceTracking.Helpers"
    xmlns:services="using:VRCFaceTracking.Services"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="LogLevelWarningBrush" Color="#FFFF23" />
        <SolidColorBrush x:Key="LogLevelErrorBrush" Color="#DB2543" />
        <SolidColorBrush x:Key="LogLevelCriticalBrush" Color="#A70023" />

        <!-- One plain TextBlock per line, coloured by picking a template. Each line used to
             carry six DataTriggerBehaviors, one per log level: 31,000 behaviour objects for
             5,163 lines, all tracked by every garbage collection. -->
        <DataTemplate x:Key="PlainLogLineTemplate" x:DataType="services:LogLine">
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Message}" />
        </DataTemplate>
        <DataTemplate x:Key="WarningLogLineTemplate" x:DataType="services:LogLine">
            <TextBlock Foreground="{StaticResource LogLevelWarningBrush}" Text="{x:Bind Message}" />
        </DataTemplate>
        <DataTemplate x:Key="ErrorLogLineTemplate" x:DataType="services:LogLine">
            <TextBlock Foreground="{StaticResource LogLevelErrorBrush}" Text="{x:Bind Message}" />
        </DataTemplate>
        <DataTemplate x:Key="CriticalLogLineTemplate" x:DataType="services:LogLine">
            <TextBlock Foreground="{StaticResource LogLevelCriticalBrush}" Text="{x:Bind Message}" />
        </DataTemplate>
        <local:LogLineTemplateSelector x:Key="LogLineTemplateSelector"
                                       PlainTemplate="{StaticResource PlainLogLineTemplate}"
                                       WarningTemplate="{StaticResource WarningLogLineTemplate}"
                                       ErrorTemplate="{StaticResource ErrorLogLineTemplate}"
                                       CriticalTemplate="{StaticResource CriticalLogLineTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
          <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0, 20, 0, 0" Padding="5" CornerRadius="6" BorderThickness="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
              <Grid>
                  <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Padding="10, 10, 0, 10" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button ToolTipService.ToolTip="Copy to Clipboard" Click="CopyToClipboard_OnClick" Height="36">
                          <Button.Content>
                              <FontIcon FontSize="20" Glyph="&#xE8C8;" />
                          </Button.Content>
                      </Button>
                      <AppBarSeparator Margin="5, 0, 5, 0"/>
                      <Button ToolTipService.ToolTip="Save to File" Click="SaveToFile_OnClick" Height="36">
                          <Button.Content>
                              <FontIcon FontSize="20" Glyph="&#xEA35;" />
                          </Button.Content>
                      </Button>
                      <TextBlock x:Name="SaveStatus" TextWrapping="Wrap" VerticalAlignment="Center" Style="{ThemeResource DetailBodyBaseMediumStyle}" Padding="20, 0, 0, 0"/>
                  </StackPanel>
              </Grid>
          </Border>

        <Border Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0, 20, 0, 20" Padding="5" CornerRadius="6" BorderThickness="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <!-- ItemsRepeater directly inside the ScrollViewer only creates the lines in view.
                 The ItemsControl it replaces sat in a StackPanel, which measures without a
                 height limit, so every line in the log got its own elements. ItemsSource is
                 set and cleared in code-behind, because the log is static and outlives the
                 page: bound for good, it would keep every Output page ever opened alive. -->
            <ScrollViewer
                x:Name="LogScroller"
                Padding="10"
                IsTabStop="False"
                UseSystemFocusVisuals="False"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                HorizontalScrollBarVisibility="Auto"
                Height="Auto">
                <ItemsRepeater x:Name="LogRepeater" ItemTemplate="{StaticResource LogLineTemplateSelector}" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
