<Page
    x:Class="VRCFaceTracking.Views.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VRCFaceTracking.ViewModels"
    xmlns:services="using:VRCFaceTracking.Core.Services"
    xmlns:helpers="using:VRCFaceTracking.Helpers">

    <Page.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12" Margin="0,0,0,20">

            <!-- Master switch : green section -->
            <Border Style="{StaticResource Cat518SectionBorderStyle}"
                    Background="{StaticResource Cat518GreenTint}"
                    BorderBrush="{StaticResource Cat518GreenEdge}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Only start modules whose source is live"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Cat518Green}"/>
                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="Off = start every installed module and let each one fail on its own (stock behaviour)."
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Re-scan"
                            Click="Rescan_OnClick"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"/>
                    <ToggleSwitch Grid.Column="2"
                                  IsOn="{x:Bind ViewModel.GatingEnabled, Mode=TwoWay}"
                                  MinWidth="0"
                                  VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Detected sources : cyan section -->
            <Border Style="{StaticResource Cat518SectionBorderStyle}"
                    Background="{StaticResource Cat518CyanTint}"
                    BorderBrush="{StaticResource Cat518CyanEdge}">
                <StackPanel>
                    <TextBlock Text="Tracking sources on this PC"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Cat518Cyan}"/>
                    <TextBlock Text="The gear stores a launch command per source (exe path or steam:// URI); Launch appears whenever that source isn't running."
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Sources, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SourceRow">
                                <Grid Padding="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="2*" MinWidth="150"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border CornerRadius="9" Padding="7,1,7,1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource Cat518GreenTint}"
                                            BorderBrush="{StaticResource Cat518Green}"
                                            BorderThickness="1"
                                            Visibility="{x:Bind Strong, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource Cat518Green}"/>
                                    </Border>
                                    <Border CornerRadius="9" Padding="7,1,7,1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource Cat518YellowTint}"
                                            BorderBrush="{StaticResource Cat518Yellow}"
                                            BorderThickness="1"
                                            Visibility="{x:Bind WeakOnly, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="WEAK" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource Cat518Yellow}"/>
                                    </Border>
                                    <TextBlock Text="idle" FontSize="10"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               Visibility="{x:Bind Detected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"/>

                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind Name}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{x:Bind Evidence}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind Notes}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind LaunchStatus, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Cat518Green}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind HasLaunchStatus, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="Launch"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Click="{x:Bind Launch}"
                                                    IsEnabled="{x:Bind CanLaunch, Mode=OneWay}"
                                                    Visibility="{x:Bind ShowLaunch, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Padding="6,4,6,4"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Set the launch command for this source">
                                                <FontIcon Glyph="&#xE713;" FontSize="14"/>
                                                <Button.Flyout>
                                                    <Flyout Placement="Left">
                                                        <StackPanel Width="380" Spacing="8">
                                                            <TextBlock FontWeight="SemiBold">
                                                                <Run Text="Launch command for"/>
                                                                <Run Text="{x:Bind Name}"/>
                                                            </TextBlock>
                                                            <TextBox Text="{x:Bind LaunchCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     PlaceholderText="C:\path\to\app.exe  -or-  steam://rungameid/..."
                                                                     FontFamily="Consolas" FontSize="12"/>
                                                            <TextBlock Text="Quotes around paths with spaces are optional; anything after the path is passed as arguments. Clear the box to remove the button."
                                                                       FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                       TextWrapping="Wrap"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Button Content="Save"
                                                                        Style="{StaticResource AccentButtonStyle}"
                                                                        Click="{x:Bind SaveCommand}"/>
                                                                <Button Content="Browse..."
                                                                        Click="{x:Bind Browse}"/>
                                                            </StackPanel>
                                                            <ToggleSwitch Header="Launch with VRCFaceTracking"
                                                                          OnContent="Starts when VRCFT starts"
                                                                          OffContent="Manual only"
                                                                          MinWidth="0"
                                                                          IsOn="{x:Bind AutoLaunch, Mode=TwoWay}"/>
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Text="auto-launch"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   Visibility="{x:Bind AutoLaunch, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Installed modules : purple section -->
            <Border Style="{StaticResource Cat518SectionBorderStyle}"
                    Background="{StaticResource Cat518PurpleTint}"
                    BorderBrush="{StaticResource Cat518PurpleEdge}">
                <StackPanel>
                    <TextBlock Text="Installed modules"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Cat518Purple}"/>
                    <TextBlock Text="Auto follows detection. Always ignores detection and starts anyway. Never keeps it off. Changes apply on the next re-initialise."
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Modules, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModuleRow">
                                <Grid Padding="0,5,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="2*" MinWidth="150"/>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                               FontSize="10" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Cat518Green}"
                                               Visibility="{x:Bind WillStart, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                               FontSize="10" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Cat518Red}"
                                               Visibility="{x:Bind WillStart, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{x:Bind DisplayName}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind MappedSources}"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind Reason, Mode=OneWay}"
                                               FontFamily="Consolas" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>

                                    <ComboBox Grid.Column="3"
                                              MinWidth="96"
                                              VerticalAlignment="Center"
                                              SelectedIndex="{x:Bind ModeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="Auto"/>
                                        <ComboBoxItem Content="Always"/>
                                        <ComboBoxItem Content="Never"/>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Nothing installed yet."
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               FontSize="12"
                               Visibility="{x:Bind NoModulesVisibility, Mode=OneWay}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
